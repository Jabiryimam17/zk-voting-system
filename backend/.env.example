# PostgreSQL Database (Aizen)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=election
DB_USER_NAME=your-db-username
DB_PASSWORD=your-db-password
DB_SSL=true # Set to true for secure cloud-hosted databases (e.g. Aiven, Neon)

# JWT (RSA keys must be base64-encoded)
# To encode: cat keys/private.key | base64 -w 0
# To encode: cat keys/public.key | base64 -w 0
JWT_SECRET_KEY=your-jwt-secret
PRIVATE_KEY=base64-encoded-private-key
PUBLIC_KEY=base64-encoded-public-key

# Email (Brevo SMTP relay — generate key at https://app.brevo.com/settings/keys/smtp)
EMAIL_SENDER=your-verified-sender@domain.com
BREVO_SMTP_USER=your-brevo-account-login@domain.com
BREVO_SMTP_KEY=your-brevo-smtp-key

# External Services
NATIONAL_ID_HOST=https://your-national-id-service.vercel.app

# Frontend URL (for CORS)
FRONTEND_HOST=https://your-frontend.vercel.app
